From: harsha-cpp <sriharshatummalapalli@gmail.com>
Date: Sun, 27 Sep 2026 17:50:45 +0530
Subject: [PATCH 1/2] retrieval: deterministic exact-key ordering + compound
 name+number path

- ORDER BY rowid on exact_name/exact_core/core_prefix lookups so a large
  common-name block consumes the path quota deterministically, not arbitrarily
- add name_number compound path (name AND address-number conjunction) that
  engages when the exact-core block fills path_top_k, letting address evidence
  discriminate within common-name blocks

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 .../src/blocking/disk_index.py                |  26 ++++-
 tests/test_disk_index_retrieval.py            | 106 ++++++++++++++++++
 2 files changed, 129 insertions(+), 3 deletions(-)
 create mode 100644 tests/test_disk_index_retrieval.py

diff --git a/code/business_entity_resolution/src/blocking/disk_index.py b/code/business_entity_resolution/src/blocking/disk_index.py
index 8b55412..b8a4cd4 100644
--- a/code/business_entity_resolution/src/blocking/disk_index.py
+++ b/code/business_entity_resolution/src/blocking/disk_index.py
@@ -342,11 +342,31 @@ class DiskSourceIndex:
             for path, rows in self.anchors.query(reference, self).items():
                 add(path, rows)
             return self.finish_query(reference, paths, return_all=return_all)
+        exact_block_rows: list[int] = []
         for path, column, value in (("exact_name", "name", reference.name), ("exact_core", "core", reference.core), ("core_prefix", "prefix", "".join(reference.core.split())[:8])):
             if value:
-                # Bounded exact lookup; lexical/address paths provide additional
-                # branch evidence when identical names occur in large blocks.
-                add(path, [r[0] for r in self.connection.execute(f"SELECT rowid FROM records WHERE {column}=? LIMIT ?", (value, cfg.path_top_k))])
+                # Bounded exact lookup with a deterministic rowid order. Without
+                # ORDER BY, a large block of identical common names can consume
+                # the whole path quota in an arbitrary order before any address
+                # evidence is considered.
+                rows = [r[0] for r in self.connection.execute(
+                    f"SELECT rowid FROM records WHERE {column}=? ORDER BY rowid LIMIT ?", (value, cfg.path_top_k))]
+                add(path, rows)
+                if column == "core":
+                    exact_block_rows = rows
+        # Compound retrieval: when the exact-name block is large (a common
+        # name), a name+number conjunction lets address evidence discriminate
+        # within the block instead of relying on arbitrary truncation.
+        if reference.core and reference.address_digits:
+            block_full = len(exact_block_rows) >= cfg.path_top_k
+            if block_full:
+                number_terms = ["a" + t for t in sorted(reference.address_digits)]
+                number_terms = [t for t in number_terms if 0 < self.df("digits", t) <= cfg.max_address_df]
+                if number_terms:
+                    name_terms = self.rare_terms("name", reference.name_tokens, cfg.max_word_df, cfg.query_tokens)
+                    if name_terms:
+                        expression = self.expression("name", name_terms) + " AND " + self.expression("digits", number_terms)
+                        add("name_number", self.search(expression, country=reference.country or None))
         names = self.rare_terms("name", reference.name_tokens, cfg.max_word_df, cfg.query_tokens)
         addresses = self.rare_terms("address", reference.address_tokens, cfg.max_address_df, cfg.query_tokens)
         numbers = ["n" + t for t in reference.name_digits] + ["a" + t for t in reference.address_digits]
