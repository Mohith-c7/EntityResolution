@@ -0,0 +1,106 @@
+"""Tests for deterministic, evidence-ordered disk retrieval.
+
+These exercise the SQLite-backed ``DiskSourceIndex`` directly. They focus on
+the exact-key lookups, which historically used a bare ``LIMIT`` with no
+secondary ordering, so a large block of identical common names could consume
+the whole path quota in an arbitrary (rowid) order before any address evidence
+was considered.
+"""
+
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+import pandas as pd
+
+PROJECT_CODE = Path(__file__).resolve().parents[1] / "code" / "business_entity_resolution"
+if str(PROJECT_CODE) not in sys.path:
+    sys.path.insert(0, str(PROJECT_CODE))
+
+from src.blocking.disk_index import (  # noqa: E402
+    DiskSearchConfig,
+    DiskSourceIndex,
+    build_disk_index,
+    normalize_record,
+)
+
+
+def _write_source(path: Path, rows: list[dict[str, str]], source: str) -> None:
+    frame = pd.DataFrame(rows, columns=["entity_id", "business_name", "business_address", "country"])
+    frame.to_csv(path, sep="\t", index=False)
+
+
+def _build(tmp: Path, rows: list[dict[str, str]], source: str = "S2") -> DiskSourceIndex:
+    src = tmp / f"{source}.tsv"
+    _write_source(src, rows, source)
+    index_path = tmp / f"{source}.sqlite"
+    build_disk_index(src, index_path, source)
+    return DiskSourceIndex(index_path, DiskSearchConfig())
+
+
+class ExactKeyOrderingTests(unittest.TestCase):
+    def test_exact_core_lookup_is_deterministic(self) -> None:
+        with tempfile.TemporaryDirectory() as tmpdir:
+            tmp = Path(tmpdir)
+            # Many records share one common core name; only the rowid differs.
+            rows = [
+                {
+                    "entity_id": f"S2-{i}",
+                    "business_name": "Lille Ecole SAS",
+                    "business_address": f"{i} Rue Example, Lille",
+                    "country": "France",
+                }
+                for i in range(200)
+            ]
+            index = _build(tmp, rows)
+            reference = normalize_record(
+                {"entity_id": "S1-1", "business_name": "Lille Ecole SAS",
+                 "business_address": "5 Rue Example, Lille", "country": "France"}
+            )
+            config = DiskSearchConfig(path_top_k=80)
+            index.config = config
+            first = index.connection.execute(
+                "SELECT rowid FROM records WHERE core=? LIMIT ?", (reference.core, config.path_top_k)
+            ).fetchall()
+            # Repeated queries must return the same rowids in the same order.
+            for _ in range(5):
+                again = index.connection.execute(
+                    "SELECT rowid FROM records WHERE core=? LIMIT ?", (reference.core, config.path_top_k)
+                ).fetchall()
+                self.assertEqual(first, again)
+            index.close()
+
+    def test_compound_name_number_path_exists(self) -> None:
+        with tempfile.TemporaryDirectory() as tmpdir:
+            tmp = Path(tmpdir)
+            # Fill the exact-core block (>= path_top_k) with a common name so the
+            # compound name+number path engages. Give each a distinct street number.
+            rows = [
+                {"entity_id": f"S2-{i}", "business_name": "Acme Services",
+                 "business_address": f"{1000 + i} Oak Road, Springfield", "country": "US"}
+                for i in range(200)
+            ]
+            # The true match shares the reference's street number.
+            rows.append({"entity_id": "S2-true", "business_name": "Acme Services",
+                         "business_address": "10 Oak Road, Springfield", "country": "US"})
+            index = _build(tmp, rows)
+            index.config = DiskSearchConfig(path_top_k=80)
+            reference = normalize_record(
+                {"entity_id": "S1-1", "business_name": "Acme Services",
+                 "business_address": "10 Oak Road, Springfield", "country": "US"}
+            )
+            results = index.query(reference, return_all=True)
+            paths = {p for cand, _ in results for p in cand.blocking_paths}
+            # The compound name+number path must engage for the full common block.
+            self.assertTrue(any("name_number" in p for p in paths),
+                            f"expected a name_number path, got {paths}")
+            # And it must retrieve the record that shares the street number.
+            by_id = {cand.candidate_entity_id: cand for cand, _ in results}
+            self.assertIn("S2-true", by_id)
+            self.assertIn("name_number", by_id["S2-true"].blocking_paths)
+            index.close()
+
+
+if __name__ == "__main__":
+    unittest.main()
